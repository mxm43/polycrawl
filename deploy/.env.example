# ═══════════════════════════════════════════════════════════════
# PolyCrawl — NAS Docker 部署环境变量
# 复制此文件为 .env 并修改其中的密码等敏感信息
#
# 安全注意事项：
#   - 修改后执行：chmod 600 .env（仅 owner 可读）
#   - 确保 .env 已被 .gitignore 排除，勿提交到 Git！
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=polycrawl
POSTGRES_PASSWORD=CHANGE_ME_NOW
POSTGRES_DB=polycrawl_db

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_NOW

# ── PolyCrawl ───────────────────────────────────────────────
# 数据库和 Redis 连接串（通常无需修改，除非外部服务）
# POLYCRAWL_DATABASE_URL=postgresql+asyncpg://polycrawl:CHANGE_ME_NOW@postgres:5432/polycrawl_db
# POLYCRAWL_REDIS_URL=redis://:CHANGE_ME_NOW@redis:6379/0

# ── 时区 ────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ── 数据持久化路径（NAS 共享文件夹挂载点） ─────────────────
# 如果使用 NAS 共享文件夹存储下载的媒体文件，取消注释并修改路径
# MEDIA_VOLUME=/volume1/media/polycrawl-downloads

# ── 端口映射（避免 NAS 上端口冲突） ────────────────────────
# API_PORT=8000
